rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function owns(uid) { return signed() && request.auth.uid == uid; }
  function admin() { return signed() && request.auth.token.email == 'hamzaalfarraj16@gmail.com' && request.auth.token.email_verified == true; }
  function verifiedHost(uid) { return exists(/databases/$(database)/documents/hosts/$(uid)) && get(/databases/$(database)/documents/hosts/$(uid)).data.verified == true; }
  function text(x, low, high) { return x is string && x.size() >= low && x.size() <= high; }
  function photo(x) { return x is string && x.size() <= 180000 && (x == '' || x.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')); }
  function placeRegion(x) { return {"petra": "maan", "little-petra": "maan", "rum": "aqaba", "aqaba": "aqaba", "jerash": "jerash", "dibeen": "jerash", "madaba": "madaba", "ajloun": "ajloun", "umm-qais": "irbid", "pella": "irbid", "yarmouk": "irbid", "dead-sea": "balqa", "salt": "balqa", "dana": "tafilah", "karak": "karak", "umm-jimal": "mafraq", "azraq": "zarqa", "shaumari": "zarqa"}[x]; }
  function region(x) { return x in ['maan','aqaba','jerash','madaba','ajloun','irbid','balqa','tafilah','karak','mafraq','zarqa']; }
  match /users/{uid} {
   function valid() {
    let d = request.resource.data;
    return d.keys().hasOnly(['uid','email','fullName','username','bio','city','travelMood','photoData','createdAt','updatedAt','onboardingCompleted','travelState'])
     && d.uid == uid && d.email == request.auth.token.email && text(d.fullName,2,100)
     && (!('username' in d) || (text(d.username,0,40) && d.username.matches('^[A-Za-z0-9_.-]*$')))
     && (!('bio' in d) || text(d.bio,0,500)) && (!('city' in d) || text(d.city,0,100))
     && (!('travelMood' in d) || d.travelMood in ['', 'adventure','calm','food','photo','مغامرة','هدوء وتأمل','طعام وثقافة','تصوير'])
     && (!('photoData' in d) || photo(d.photoData))
     && (!('onboardingCompleted' in d) || d.onboardingCompleted is bool)
     && (!('travelState' in d) || (d.travelState is map && d.travelState.keys().hasOnly(['dalil_trip_v1','dalil_plan_v1','dalil_mood','tripItems','dalil_bookings_v1'])));
   }
   allow get: if owns(uid);
   allow list,delete: if false;
   allow create: if owns(uid) && valid() && request.resource.data.createdAt == request.time;
   allow update: if owns(uid) && valid() && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) && request.resource.data.updatedAt == request.time;
  }
  match /trips/{id} {
   function valid() { let d=request.resource.data;
    return d.keys().hasOnly(['uid','name','startDate','days','stops','status','createdAt','updatedAt'])
      && text(d.name,2,100) && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && d.days is int && d.days>=1 && d.days<=14 && d.stops is list && d.stops.size()<=200
      && d.status in ['planned','current','completed','archived'] && d.updatedAt==request.time;
   }
   allow read: if owns(resource.data.uid);
   allow create: if owns(request.resource.data.uid) && valid() && request.resource.data.createdAt==request.time;
   allow update: if owns(resource.data.uid) && request.resource.data.uid==resource.data.uid && request.resource.data.createdAt==resource.data.createdAt && valid();
   allow delete: if owns(resource.data.uid);
  }
  match /hostApplications/{uid} {
   function valid() {let d=request.resource.data;return d.keys().hasOnly(['uid','fullName','bio','phone','regionId','photoData','identityData','publishPhone','status','reviewNote','createdAt','updatedAt'])
    && d.uid==uid && text(d.fullName,2,100) && text(d.bio,30,1000) && text(d.phone,7,30)
    && region(d.regionId) && photo(d.photoData) && photo(d.identityData) && d.identityData.size()>30
    && d.publishPhone is bool && d.status in ['pending','approved','rejected'] && text(d.reviewNote,0,500) && d.updatedAt==request.time;}
   allow get: if owns(uid) || admin();
   allow list: if admin();
   allow create: if owns(uid) && request.auth.token.email_verified==true && valid() && request.resource.data.status=='pending' && request.resource.data.reviewNote=='' && request.resource.data.createdAt==request.time;
   allow update: if valid() && ((admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','updatedAt'])) || (owns(uid) && request.auth.token.email_verified==true && resource.data.status=='rejected' && request.resource.data.status=='pending' && request.resource.data.reviewNote==''));
   allow delete: if admin();
  }
  match /hosts/{uid} {
   allow get: if owns(uid) || admin() || resource.data.verified==true;
   allow list: if admin() || resource.data.verified==true;
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['uid','fullName','bio','regionId','photoData','publicPhone','verified','verifiedAt']) && request.resource.data.uid==uid && text(request.resource.data.fullName,2,100) && text(request.resource.data.bio,30,1000) && region(request.resource.data.regionId) && photo(request.resource.data.photoData) && text(request.resource.data.publicPhone,0,30) && request.resource.data.verified is bool;
   allow delete: if admin();
  }
  match /experiences/{id} {
   function valid() {let d=request.resource.data;return d.keys().hasOnly(['hostUid','titleAr','titleEn','descriptionAr','descriptionEn','category','placeId','regionId','priceCents','duration','photoData','communityBps','status','createdAt','updatedAt'])
    && text(d.titleAr,5,120) && text(d.titleEn,5,120) && text(d.descriptionAr,50,3000) && text(d.descriptionEn,50,3000)
    && d.category in ['meal','workshop','tour'] && d.placeId in ['petra','rum','jerash','madaba','ajloun','umm-qais','dead-sea','dana','little-petra','karak','aqaba','umm-jimal','pella','salt','dibeen','azraq','shaumari','yarmouk'] && region(d.regionId) && d.regionId==placeRegion(d.placeId)
    && d.priceCents is int && d.priceCents>=100 && d.priceCents<=100000 && d.duration is int && d.duration>=15 && d.duration<=720
    && photo(d.photoData) && d.communityBps==1000 && d.status in ['pending','approved','rejected'] && d.updatedAt==request.time;}
   allow read: if admin() || owns(resource.data.hostUid) || resource.data.status=='approved';
   allow create: if owns(request.resource.data.hostUid) && verifiedHost(request.auth.uid) && valid() && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time;
   allow update: if valid() && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.hostUid==resource.data.hostUid && ((admin() && verifiedHost(resource.data.hostUid)) || (owns(resource.data.hostUid) && resource.data.status!='approved' && request.resource.data.status=='pending'));
   allow delete: if admin() && resource.data.status!='approved';
  }
  match /slots/{id} {
   function valid() { let d=request.resource.data;let x=get(/databases/$(database)/documents/experiences/$(d.experienceId)).data;
    return d.keys().hasOnly(['experienceId','hostUid','regionId','titleAr','titleEn','capacity','booked','priceCents','communityBps','startAt','endAt','open','lastBookingId'])
    && x.status=='approved' && verifiedHost(d.hostUid) && d.hostUid==x.hostUid && d.regionId==x.regionId && d.titleAr==x.titleAr && d.titleEn==x.titleEn
    && d.priceCents==x.priceCents && d.communityBps==x.communityBps && d.capacity is int && d.capacity>=1 && d.capacity<=50
    && d.booked is int && d.booked>=0 && d.booked<=d.capacity && d.startAt is timestamp && d.endAt==d.startAt+duration.value(x.duration,'m') && d.open is bool;}
   function seatChange() {let old=resource.data;let now=request.resource.data;
    let path=/databases/$(database)/documents/bookings/$(now.lastBookingId);
    let after=getAfter(path).data;
    return signed() && now.diff(old).affectedKeys().hasOnly(['booked','lastBookingId'])
      && now.booked>=0 && now.booked<=now.capacity && after.slotId==id
      && ((!exists(path) && after.uid==request.auth.uid && after.status=='confirmed' && now.booked==old.booked+after.guests)
       || (exists(path) && (owns(after.uid)||owns(after.hostUid)) && get(path).data.status=='confirmed' && after.status=='cancelled' && now.booked==old.booked-get(path).data.guests));}
   allow read: if true;
   allow create: if owns(request.resource.data.hostUid) && valid() && request.resource.data.startAt>request.time && request.resource.data.booked==0 && request.resource.data.lastBookingId=='' && request.resource.data.open==true;
   allow update: if seatChange() || (owns(resource.data.hostUid) && verifiedHost(request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']) && request.resource.data.open is bool);
   allow delete: if false;
  }
  match /bookings/{id} {
   function validNew() {let d=request.resource.data;let s=get(/databases/$(database)/documents/slots/$(d.slotId)).data;let a=getAfter(/databases/$(database)/documents/slots/$(d.slotId)).data;
    return d.keys().hasOnly(['uid','hostUid','experienceId','slotId','travelerName','guests','totalCents','communityCents','hostCents','status','paymentMethod','hostPaid','travelerPaid','startAt','endAt','titleAr','titleEn','regionId','createdAt','updatedAt'])
     && (id==request.auth.uid+'_'+d.slotId || id.matches('^'+request.auth.uid+'_'+d.slotId+'_[A-Za-z0-9-]+$')) && d.uid==request.auth.uid && d.hostUid==s.hostUid && d.uid!=d.hostUid && verifiedHost(d.hostUid)
     && d.experienceId==s.experienceId && s.open && s.startAt>request.time
     && get(/databases/$(database)/documents/experiences/$(d.experienceId)).data.status=='approved'
     && text(d.travelerName,2,100) && d.guests is int && d.guests>=1 && d.guests<=10
     && d.totalCents==s.priceCents*d.guests && d.communityCents==int(d.totalCents * s.communityBps / 10000) && d.hostCents==d.totalCents-d.communityCents
     && d.status=='confirmed' && d.paymentMethod=='cash' && d.hostPaid==false && d.travelerPaid==false
     && d.startAt==s.startAt && d.endAt==s.endAt && d.titleAr==s.titleAr && d.titleEn==s.titleEn && d.regionId==s.regionId
     && d.createdAt==request.time && d.updatedAt==request.time && a.lastBookingId==id && a.booked==s.booked+d.guests && a.booked<=s.capacity;}
   function cancellation() {let old=resource.data;let d=request.resource.data;
    let s=get(/databases/$(database)/documents/slots/$(old.slotId)).data;let a=getAfter(/databases/$(database)/documents/slots/$(old.slotId)).data;
    return old.status=='confirmed' && old.startAt>request.time && d.status=='cancelled' && d.cancelledBy==request.auth.uid && d.updatedAt==request.time
      && ((owns(old.uid) && request.time<=old.startAt-duration.value(48,'h'))||owns(old.hostUid))
      && d.diff(old).affectedKeys().hasOnly(['status','cancelledBy','updatedAt']) && a.lastBookingId==id && a.booked==s.booked-old.guests;}
   function cash() {let old=resource.data;let d=request.resource.data;
    return old.status=='confirmed' && old.endAt<=request.time && d.updatedAt==request.time
     && ((owns(old.uid) && old.travelerPaid==false && d.travelerPaid==true && d.diff(old).affectedKeys().hasOnly(['travelerPaid','updatedAt']))
       || (owns(old.hostUid) && old.hostPaid==false && d.hostPaid==true && d.diff(old).affectedKeys().hasOnly(['hostPaid','updatedAt'])));}
   allow get: if admin() || (signed() && id.matches('^'+request.auth.uid+'_.*$')) || owns(resource.data.hostUid);
   allow list: if admin() || owns(resource.data.uid) || owns(resource.data.hostUid);
   allow create: if signed() && validNew();
   allow update: if signed() && (cancellation() || cash());
   allow delete: if false;
  }
  match /reviews/{id} {
   allow read: if true;
   allow create: if signed() && request.resource.data.keys().hasOnly(['uid','hostUid','experienceId','bookingId','rating','text','createdAt'])
    && owns(request.resource.data.uid) && request.resource.data.bookingId==id
    && get(/databases/$(database)/documents/bookings/$(id)).data.uid==request.auth.uid
    && get(/databases/$(database)/documents/bookings/$(id)).data.hostUid==request.resource.data.hostUid
    && get(/databases/$(database)/documents/bookings/$(id)).data.experienceId==request.resource.data.experienceId
    && get(/databases/$(database)/documents/bookings/$(id)).data.status=='confirmed'
    && get(/databases/$(database)/documents/bookings/$(id)).data.endAt<=request.time
    && get(/databases/$(database)/documents/bookings/$(id)).data.hostPaid==true && get(/databases/$(database)/documents/bookings/$(id)).data.travelerPaid==true
    && request.resource.data.rating is int && request.resource.data.rating>=1 && request.resource.data.rating<=5 && text(request.resource.data.text,10,1000) && request.resource.data.createdAt==request.time;
   allow update,delete: if admin();
  }
  match /goals/{id} {
   allow read: if admin() || resource.data.published==true;
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['titleAr','titleEn','descriptionAr','descriptionEn','regionId','targetCents','published','createdAt'])
    && text(request.resource.data.titleAr,5,120) && text(request.resource.data.titleEn,5,120) && text(request.resource.data.descriptionAr,30,2000) && text(request.resource.data.descriptionEn,30,2000) && region(request.resource.data.regionId)
    && request.resource.data.targetCents is int && request.resource.data.targetCents>=100 && request.resource.data.targetCents<=100000000 && request.resource.data.published is bool;
   allow delete: if false;
  }
  match /receiptEvidence/{id} {
   allow read: if admin();
   allow create: if admin() && request.resource.data.keys().hasOnly(['reference','recordedBy','createdAt']) && text(request.resource.data.reference,5,200) && request.resource.data.recordedBy==request.auth.uid && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
  }
  match /contributions/{id} {
   allow read: if resource.data.status=='received' || admin();
   allow create: if admin() && request.resource.data.keys().hasOnly(['bookingId','goalId','amountCents','status','createdAt'])
    && request.resource.data.bookingId==id && request.resource.data.status=='received' && request.resource.data.createdAt==request.time
    && get(/databases/$(database)/documents/bookings/$(id)).data.status=='confirmed'
    && get(/databases/$(database)/documents/bookings/$(id)).data.hostPaid==true && get(/databases/$(database)/documents/bookings/$(id)).data.travelerPaid==true
    && request.resource.data.amountCents==get(/databases/$(database)/documents/bookings/$(id)).data.communityCents
    && get(/databases/$(database)/documents/goals/$(request.resource.data.goalId)).data.published==true
    && get(/databases/$(database)/documents/goals/$(request.resource.data.goalId)).data.regionId==get(/databases/$(database)/documents/bookings/$(id)).data.regionId
    && exists(/databases/$(database)/documents/receiptEvidence/$(id));
   allow update,delete: if false;
  }
 }
}
